{
  "$schema": "https://beepboop.kjanat.dev/schema/v1.json",
  "managers": ["github-release", "workflow"],
  "streams": {
    "main": {
      "versionSource": {
        "kind": "tags",
        "prefix": "v"
      },
      "versionScope": "none",
      "versionFiles": [
        {
          "path": "package.json",
          "format": "json",
          "key": ["version"]
        }
      ],
      "prepare": {
        "strategy": "managed",
        "version": "manual",
        "versionLands": "via-version-pr",
        "versionPrMerge": "manual",
        "workflow": {
          "file": "prepare-release.yml",
          "ref": "master"
        }
      },
      "promote": {
        "publishWhen": "approved-in-beepboop",
        "workflow": {
          "file": "publish.yml",
          "ref": "master",
          "publications": ["github-release:kjanat/setup-zig"],
          "refs": {
            "phase": "version",
            "prefix": "v",
            "signed": true,
            "immutable": true,
            "distribution": {
              "files": ["dist/main.mjs", "dist/post.mjs"],
              "ancestry": "ours"
            }
          }
        }
      },
      "workflows": {
        "aliases": {
          "file": "aliases.yml",
          "ref": "master",
          "needs": ["promote"],
          "refs": {
            "phase": "aliases",
            "prefix": "v",
            "aliases": ["major", "minor"]
          }
        }
      }
    }
  }
}
