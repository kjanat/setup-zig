{
	"compilerOptions": {
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": [
			"node"
		],
		"lib": [
			"ES2024"
		],
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"scripts/**/*.ts",
		"tsdown.config.ts"
	]
}
