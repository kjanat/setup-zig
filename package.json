{
	"name": "setup-zig",
	"version": "3.1.1",
	"private": true,
	"description": "Install verified Zig compilers and preserve Zig build caches in Actions workflows",
	"license": "MIT",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#test": "./test/*.ts",
		"#pkg": "./package.json"
	},
	"scripts": {
		"actionlint": "bunx yomama@https://pkg.pr.new/kjanat/actionlint/@kjanat/actionlint@master",
		"preactionlint:run": "tsdown --logLevel silent",
		"actionlint:run": "run actionlint check --strict --ignore action/missing-file",
		"build": "node scripts/build.ts",
		"precheck:dist": "bun run build",
		"check:dist": "node --check dist/*",
		"fmt": "bunx @kjanat/fmt --excludes dist",
		"test": "node --experimental-vm-modules --test test/*.test.ts",
		"typecheck": "tsrs --noEmit && tsrs --noEmit --project test"
	},
	"devDependencies": {
		"@actions/cache": "^6.3.0",
		"@actions/core": "^3.0.1",
		"@actions/exec": "^3.0.0",
		"@actions/tool-cache": "^4.0.0",
		"@kjanat/fmt": "^0.64.1",
		"@tabnas/jsonic": "^0.7.12",
		"@tabnas/parser": "^0.12.20",
		"@tabnas/zon": "^0.5.19",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"rollup-plugin-license": "3.7.2",
		"runner-run": "^0.28.0",
		"tsdown": "^0.23.7",
		"tsrs": "latest",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun@1.4.5",
	"engines": {
		"node": ">=24"
	},
	"trustedDependencies": [
		"@kprint/kprint"
	]
}
